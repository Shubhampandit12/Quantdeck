# QuantDeck configuration. Copy to .env and fill in what you have.
# ONLY read-only market-data keys and the AI key are used. There is NO setting
# that enables real-money trading.

# --- AI trading (optional; features disable gracefully without it) ---
# ANTHROPIC_API_KEY is read directly; or set QUANTDECK_ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=sk-ant-...
QUANTDECK_AI_MODEL=claude-sonnet-5

# --- US equity real-time data (optional; falls back to Yahoo delayed) ---
QUANTDECK_FINNHUB_API_KEY=
QUANTDECK_ALPACA_API_KEY=
QUANTDECK_ALPACA_API_SECRET=
QUANTDECK_ALPHA_VANTAGE_API_KEY=

# --- Server ---
QUANTDECK_HOST=0.0.0.0
QUANTDECK_PORT=8000

# --- Defaults ---
QUANTDECK_DEFAULT_STARTING_BALANCE=100000
QUANTDECK_DEFAULT_LEVERAGE=1
